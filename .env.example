# Copy to .env and fill in real values:  cp .env.example .env

TZ=Asia/Bangkok

# MySQL root password (required — db container won't initialize without it)
MYSQL_ROOT_PASSWORD=change-me

# Backend API (node/server.js)
DB_HOST=db                # compose service name of MySQL
DB_USER=root
DB_PASSWORD=change-me     # same as MYSQL_ROOT_PASSWORD when DB_USER=root
DB_NAME=carbon_footprint_db
DB_TIMEZONE=+07:00        # must match db's --default-time-zone flag
PORT=3000
MQTT_PORT=1883
WS_PORT=8083

# MQTT broker auth — must match the password flashed on the ESP32s
MQTT_PASSWORD=change-me

# JWT signing secret (openssl rand -hex 32) — changing it invalidates all tokens
JWT_SECRET=change-me
