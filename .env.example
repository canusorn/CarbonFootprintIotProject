# ---------------------------------------------------------------------------
# Compose environment variables — copy values you want into .env and CHANGE THEM
# ---------------------------------------------------------------------------

# MySQL root password (used by both MySQL and the API — the app creates the
# `carbon_footprint_db` and `sensor` databases automatically on first start)
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# Timezone (must match the app's assumed +07:00 unless you change DB_TIMEZONE)
TZ=Asia/Bangkok

# --- API (node/server.js) ---------------------------------------------------
DB_HOST=db
DB_USER=root
DB_PASSWORD=change_me_mysql_root
DB_NAME=carbon_footprint_db
DB_TIMEZONE=+07:00

PORT=3000
MQTT_PORT=1883
WS_PORT=8083

# Password ESP32 + frontend must send to connect to the MQTT broker
# NOTE: the current dashboard hardcodes password 'pi' (DashboardView.vue)
# and username 'web' — keep MQTT_PASSWORD=pi or update that code too.
MQTT_PASSWORD=pi

# IMPORTANT: JWTs never expire in this app, so use a long random secret
JWT_SECRET=change_me_long_random_string
